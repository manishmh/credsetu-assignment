# Copy to backend/.env and adjust. Never commit real secrets.
PORT=4000
NODE_ENV=development
# Docker Compose DB (host port 5433). If you use a local Postgres on 5432, change the port.
DATABASE_URL=postgresql://miniledger:miniledger@localhost:5433/miniledger
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
UPLOAD_DIR=uploads
